# ============================================================
# keystore.properties.template
# انسخ هذا الملف إلى keystore.properties (في نفس المجلد)
# ثم أضف keystore.properties إلى .gitignore
# ============================================================

# مسار ملف الـ Keystore (جهاز التطوير أو CI/CD)
storeFile=../release.keystore

# كلمة السر الخاصة بالـ Keystore
storePassword=YOUR_STORE_PASSWORD

# اسم الـ Key Alias
keyAlias=YOUR_KEY_ALIAS

# كلمة سر الـ Key
keyPassword=YOUR_KEY_PASSWORD
